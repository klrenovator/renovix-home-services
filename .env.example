# ---------------------------------------------------------------------------
# Server-side only. Never prefix these with NEXT_PUBLIC_ — they must not
# reach the browser.
#
# OWNER-PENDING (Phase 22): none of these are configured yet, so the quote API
# honestly answers 503 "unavailable" and the form offers the WhatsApp fallback.
# See PROJECT_OWNER_PENDING.md for the go-live checklist.
# ---------------------------------------------------------------------------

# Resend API key (https://resend.com). Required for live quote-form email
# delivery. Create a key in the Resend dashboard and add it in Vercel →
# Project → Settings → Environment Variables.
RESEND_API_KEY=

# From address. Must be a sender identity / domain verified in Resend.
# Example: Renovix Home Services <noreply@renovixhomeservices.my>
QUOTE_FROM_EMAIL=

# Inbox that receives new quote requests. Defaults to the public business
# email (renovixhomeservices@gmail.com) when unset.
QUOTE_NOTIFICATION_EMAIL=

# ---------------------------------------------------------------------------
# Phase 24 — analytics & measurement (public: these are IDs, not secrets).
#
# OWNER-PENDING: none are set. With every value empty, NO measurement script
# loads at all and the site behaves exactly as before Phase 24. Do NOT invent
# placeholder IDs — a wrong ID sends data to someone else's account.
#
# Use Google Tag Manager OR the GA4 tag directly — never both. If both are
# set, only GTM loads (GA4 must then be configured inside the container).
# Full setup guide: PHASE_24_ANALYTICS.md
# ---------------------------------------------------------------------------

# GA4 Measurement ID from analytics.google.com (Admin → Data streams).
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Google Tag Manager container ID (alternative to the direct GA4 tag).
# Format: GTM-XXXXXX
NEXT_PUBLIC_GTM_CONTAINER_ID=

# Google Ads conversion tracking (optional). Conversion ID from
# ads.google.com → Goals → Conversions. Format: AW-XXXXXXXXX.
# Leave empty until the owner creates the conversion actions; labels are
# per-action ("Tag setup" → "Use Google Tag Manager"/"Google tag" → the
# label inside send_to, e.g. AW-XXXXXXXXX/abcDEfghIJk).
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=
NEXT_PUBLIC_GOOGLE_ADS_QUOTE_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_PHONE_LABEL=

# Microsoft Clarity project ID from clarity.microsoft.com (optional;
# recordings ship with default text masking left on). Alphanumeric, e.g. a1b2c3d4e5.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Verbose measurement logging in the browser console in any environment.
NEXT_PUBLIC_ANALYTICS_DEBUG=
